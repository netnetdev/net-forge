{
  "name": "@netforge/engine-sim",
  "version": "0.2.0",
  "description": "Deterministic game simulation shared by browser client and server for Net Forge: ECS, Rapier physics, a fixed tick, input commands and delta snapshots.",
  "keywords": [
    "game-engine",
    "multiplayer",
    "ecs",
    "entity-component-system",
    "rapier",
    "physics",
    "netcode",
    "client-side-prediction",
    "authoritative-server",
    "game-server",
    "typescript",
    "gamedev",
    "net-forge"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://forge.netnet.capital/docs/packages/engine-sim",
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/engine-sim"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "bitecs": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
