{
  "name": "@netforge/mcp",
  "version": "0.2.0",
  "mcpName": "io.github.netnetdev/net-forge",
  "description": "MCP server for Net Forge: lets AI coding agents list templates, scaffold a game, search the engine docs, validate a game module, run headless bot playtests and play the game locally. No chain, no keys.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./server.json": "./server.json"
  },
  "bin": {
    "netforge-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  },
  "homepage": "https://forge.netnet.capital/docs",
  "keywords": [
    "mcp",
    "model context protocol",
    "mcp server",
    "ai agents",
    "coding agents",
    "game engine",
    "browser game",
    "multiplayer",
    "three.js",
    "playtest",
    "llms-txt",
    "net-forge"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../engine/scripts/fresh-dist.mjs && tsc -p tsconfig.json && node scripts/bundle-docs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@netforge/engine": "workspace:*",
    "@netforge/engine-sim": "workspace:*",
    "@netforge/kit-play": "workspace:*",
    "esbuild": "0.25.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
