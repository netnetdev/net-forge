{
  "name": "@netforge/tabletop",
  "version": "0.2.0",
  "description": "Shared client kit for Net Forge board-style game templates (tower defense, idle, card battler, monster collector): room connection, input clock, 3D stage, store and HUD.",
  "keywords": [
    "game-engine",
    "multiplayer",
    "browser-game",
    "threejs",
    "tower-defense",
    "card-game",
    "idle-game",
    "monster-collector",
    "typescript",
    "gamedev",
    "net-forge"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/measure.ts",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://forge.netnet.capital/docs/packages/tabletop",
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/tabletop"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs"
  },
  "dependencies": {
    "@netforge/asset-library": "workspace:*",
    "@netforge/engine": "workspace:*",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/three": "0.186.0",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
