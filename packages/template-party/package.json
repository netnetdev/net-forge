{
  "name": "@netforge/template-party",
  "version": "0.2.0",
  "description": "Party game template for Net Forge: 2 to 8 friends in one playroom, five quick minigame rounds a show (ROMPHOUSE).",
  "keywords": [
    "game-template",
    "multiplayer",
    "browser-game",
    "html5-game",
    "threejs",
    "game-engine",
    "typescript",
    "gamedev",
    "ai-agents",
    "mcp",
    "net-forge",
    "party-game"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/manifest.ts",
    "./store": "./src/store.ts",
    "./package.json": "./package.json",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt"
  },
  "files": [
    "src",
    "client",
    "!client/vite.config.ts",
    "llms.txt",
    "README.md",
    "NOTICE",
    "LICENSE",
    "llms-full.txt",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "sideEffects": [
    "./src/game.ts",
    "./src/manifest.ts",
    "./client/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://forge.netnet.capital/docs/templates/party",
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/template-party"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../engine/scripts/fresh-dist.mjs && vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vite --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "bots": "tsx scripts/load-bots.ts",
    "fun": "tsx scripts/fun.ts",
    "bench": "tsx scripts/bench.ts",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs"
  },
  "dependencies": {
    "@netforge/asset-library": "workspace:*",
    "@netforge/engine": "workspace:*",
    "@netforge/engine-sim": "workspace:*",
    "nipplejs": "1.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/three": "0.186.0",
    "tsx": "4.23.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
