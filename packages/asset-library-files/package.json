{
  "name": "@netforge/asset-library-files",
  "version": "0.2.0",
  "description": "Built CC0 game asset files for Net Forge (optimized models, sprites, textures and sounds) that kit play serves to a game running locally.",
  "keywords": [
    "game-assets",
    "cc0",
    "threejs",
    "browser-game",
    "gamedev",
    "net-forge"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "library",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CC0-1.0.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://forge.netnet.capital/docs/packages/asset-library-files",
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/asset-library-files"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node scripts/stage.mjs",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs"
  }
}
