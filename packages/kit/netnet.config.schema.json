{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetNet Kit game config (netnet.config.json)",
  "type": "object",
  "required": [
    "game",
    "store",
    "earn"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,30})[a-z0-9]$",
      "description": "The game's slug on GameFactory."
    },
    "name": {
      "type": "string"
    },
    "referee": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Endpoint that verifies earn events and signs attestations."
    },
    "store": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,30}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "consumable",
              "permanent",
              "pass"
            ]
          },
          "priceUsdg": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "description": "Dollar price, e.g. \"0.50\"."
          },
          "priceToken": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "description": "Game-token price, e.g. \"10\"."
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "description": "Pass length in seconds (kind pass only)."
          }
        },
        "anyOf": [
          {
            "required": [
              "priceUsdg"
            ]
          },
          {
            "required": [
              "priceToken"
            ]
          }
        ]
      }
    },
    "earn": {
      "type": "array",
      "minItems": 1,
      "description": "At least one earn rule is mandatory.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,30}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
