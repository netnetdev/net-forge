{
  "name": "@netnetcapital/asset-library",
  "version": "0.1.0",
  "description": "The per-style asset library of the Net Forge game engine: a manifest of CC0 models and sprites addressed by library id, shared rigs and clip sets, the look composer, the example gallery, and the three.js loader the templates draw with.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three/index.ts",
    "./vite": "./src/vite.ts",
    "./fetch": "./scripts/fetch.ts",
    "./gallery": "./manifest/gallery.ts"
  },
  "files": [
    "src",
    "!src/brand",
    "!src/**/*.test.ts",
    "manifest",
    "README.md",
    "NOTICE",
    "LICENSES",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./src/index.ts",
      "./three": "./src/three/index.ts",
      "./vite": "./src/vite.ts",
      "./gallery": "./manifest/gallery.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/asset-library"
  },
  "homepage": "https://github.com/netnetdev/net-forge/tree/main/packages/asset-library#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fetch-packs": "tsx scripts/fetch.ts",
    "viewer": "vite --config viewer/vite.config.ts",
    "shoot": "tsx scripts/shoot.ts",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs"
  },
  "dependencies": {
    "@netnetcapital/engine": "workspace:*",
    "fflate": "0.8.3",
    "three": "0.186.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/three": "0.186.0",
    "tsx": "4.23.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  }
}
