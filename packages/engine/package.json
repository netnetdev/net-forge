{
  "name": "@netnetcapital/engine",
  "version": "0.1.0",
  "description": "NetNet game runtime client: the typed game API the model writes against, and the three.js runtime (WebGPU with WebGL2 fallback) that plays it.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "default": "./dist/net/index.js"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "default": "./dist/game/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./earn-source": {
      "types": "./dist/game/earn-source.d.ts",
      "default": "./dist/game/earn-source.js"
    },
    "./voxel": {
      "types": "./dist/runtime/styles/voxel/core.d.ts",
      "default": "./dist/runtime/styles/voxel/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "GAME-DESIGN.md",
    "llms.txt",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/netnetdev/net-forge/tree/main/packages/engine#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json && tsc -p tsconfig.demo.json",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "node scripts/license-gate.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.5",
    "@netnetcapital/engine-sim": "workspace:*",
    "nipplejs": "1.0.4",
    "three": "0.186.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@types/node": "22.20.1"
  },
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  }
}
