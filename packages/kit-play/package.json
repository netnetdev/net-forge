{
  "name": "@netforge/kit-play",
  "version": "0.2.0",
  "description": "Make, test and run Net Forge games on your own computer with play money: start a game from a template, run playtest bots, and play it in the browser with a local room host, with no wallet, chain or servers.",
  "keywords": [
    "game-engine",
    "multiplayer",
    "browser-game",
    "game-server",
    "websocket",
    "game-template",
    "threejs",
    "typescript",
    "gamedev",
    "ai-agents",
    "mcp",
    "vibe-coding",
    "net-forge"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./llms.txt": "./llms.txt"
  },
  "bin": {
    "kit-play": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "llms.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://forge.netnet.capital/docs/packages/kit-play",
  "bugs": {
    "url": "https://github.com/netnetdev/net-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netnetdev/net-forge.git",
    "directory": "packages/kit-play"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../engine/scripts/fresh-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "node ../engine/scripts/license-gate.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/ws-transport": "0.18.4",
    "@netforge/asset-library": "workspace:*",
    "@netforge/asset-library-files": "workspace:*",
    "@netforge/engine": "workspace:*",
    "@netforge/engine-sim": "workspace:*",
    "@netforge/tabletop": "workspace:*",
    "@netforge/template-arena": "workspace:*",
    "@netforge/template-cards": "workspace:*",
    "@netforge/template-collector": "workspace:*",
    "@netforge/template-dungeon": "workspace:*",
    "@netforge/template-idle": "workspace:*",
    "@netforge/template-party": "workspace:*",
    "@netforge/template-platformer": "workspace:*",
    "@netforge/template-racer": "workspace:*",
    "@netforge/template-survivor": "workspace:*",
    "@netforge/template-tower": "workspace:*",
    "create-netforge": "workspace:*",
    "esbuild": "0.25.12",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
