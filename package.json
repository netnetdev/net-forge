{
  "name": "net-forge",
  "private": true,
  "description": "Net Forge: an MIT TypeScript engine for multiplayer browser games, with ten finished game templates and tools for coding agents.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @netforge/engine-sim --filter @netforge/engine --filter create-netforge --filter @netforge/kit-play --filter @netforge/mcp --filter netforge --filter @netforge/kit run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test"
  }
}
